[Unit]
Description=HaierPi PR7 read-only advanced circuit telemetry
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=haier
Group=haier
WorkingDirectory=/opt/haierpi-pr7
EnvironmentFile=/etc/haierpi-pr7.env
ExecStart=/opt/haierpi-pr7/.venv/bin/python -m diagnostics.mqtt_circuit_bridge
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
