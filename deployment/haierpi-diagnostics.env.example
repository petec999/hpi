# Copy this file to /etc/haierpi-diagnostics.env, edit and chmod 600.
# Must match the broker used by the existing HaierPi.
HPI_MQTT_HOST=127.0.0.1
HPI_MQTT_PORT=1883
HPI_TOPIC=climate/haier
HPI_DISCOVERY_PREFIX=homeassistant
HPI_TZ=Europe/Warsaw
HPI_SAMPLE_TTL=120
HPI_HISTORY_RETENTION_DAYS=90
# Uncomment if MQTT requires authentication:
# HPI_MQTT_USERNAME=your-user
# HPI_MQTT_PASSWORD=your-password
