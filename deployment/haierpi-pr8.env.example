# Copy as /etc/haierpi-pr8.env (chmod 600). Do not commit passwords.
HPI_MQTT_HOST=127.0.0.1
HPI_MQTT_PORT=1883
HPI_TOPIC=climate/haier
HPI_DISCOVERY_PREFIX=homeassistant
HPI_HISTORY_FILE=/var/lib/haierpi/history.sqlite
HPI_HISTORY_SAMPLE_SECONDS=60
HPI_HISTORY_RETENTION_DAYS=90
# HPI_MQTT_USERNAME=replace-me
# HPI_MQTT_PASSWORD=replace-me
