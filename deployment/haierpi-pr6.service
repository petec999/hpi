[Unit]
Description=HaierPi PR6 read-only compressor and defrost cycle counters
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=haier
Group=haier
WorkingDirectory=/opt/haierpi-pr6
EnvironmentFile=/etc/haierpi-pr6.env
ExecStart=/opt/haierpi-pr6/.venv/bin/python -m diagnostics.mqtt_cycle_bridge
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/haierpi
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
