[Unit]
Description=HaierPi compressor and defrost cycle monitor
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=haier
Group=haier
WorkingDirectory=/opt/haierpi-diagnostics
EnvironmentFile=/etc/haierpi-diagnostics.env
ExecStart=/opt/haierpi-diagnostics/.venv/bin/python -m diagnostics.mqtt_cycle_bridge
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
