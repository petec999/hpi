# Copy to /etc/haierpi-pr6.env (chmod 600); do not commit passwords.
HPI_MQTT_HOST=127.0.0.1
HPI_MQTT_PORT=1883
HPI_TOPIC=climate/haier
HPI_DISCOVERY_PREFIX=homeassistant
HPI_SAMPLE_TTL=120
HPI_TZ=Europe/Warsaw
HPI_COUNTER_FILE=/var/lib/haierpi/cycle_counters.json
# HPI_MQTT_USERNAME=replace-me
# HPI_MQTT_PASSWORD=replace-me
